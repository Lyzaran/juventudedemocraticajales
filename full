/* ================== MOBILE ================== */
@media (max-width: 768px){
    :root{ /* SPACES */
        --spc-1: 5rem;
        --spc-2: 4rem;
        --spc-3: 3rem;
        --spc-4: 2rem;
        --spc-5: 1rem;
        --spc-6: 0.5rem;
    }
    :root{ /* TEXTO */
        --txt-1: 40px;
        --txt-2: 31px;
        --txt-3: 22px;
