<!DOCTYPE html>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Sanchez:ital@0;1&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Lilita+One&display=swap');
/* ================== ROOT ================== */
:root{ /* VALORES */
    --btn-min-h: 48px; /* ALTURA MINÍMA DE BOTÕES */
    --btn-min-gap: 16px;
    --body-max-w: 100rem;
    --body-lat-m: var(--spc-4);
    --header-h: 4rem;
    --border-1: 2px;
    --border-2: 4px;
    --transition: 0.3s;
}
:root{ /* SPACES */
    --spc-1: 10rem;
    --spc-2: 8rem;
    --spc-3: 6rem;
    --spc-4: 4rem;
    --spc-5: 2rem;
    --spc-6: 1rem;
}
:root{ /* TEXTO */
    --txt-1: 50px;
    --txt-2: 38px;
    --txt-3: 26px;
    --txt-4: 18px;
    --txt-5: 14px;
}
:root{ /* CORES */
    --cor-0: #2c2c2c;
    --cor-1: #f4f4f4;
    --cor-2: #082e86;
    --cor-3: #f8c434;
    --cor-13: #d9071a;
}
/* ================== CORE ================== */
*{
    padding: 0;
    border: 0;
    outline: 0;
    margin: 0;
    text-decoration: none;
    box-sizing: border-box;
    transition: var(--transition) ease;
    z-index: 1;
    color: var(--cor-0);
}
html{
    font-size: 16px;
}
body{
    min-height: 100vh;
    background-color: var(--cor-1);
    /* overflow-x: hidden; */
}
img{
    object-fit: cover;
}
a{
    text-decoration: underline;
    position: relative;
}
a::after{
    font-family: "Lilita One", sans-serif;
    content: ">";
    position: absolute;
    right: -1.5rem;
    bottom: 0;
}
.body{
    flex: 1; /* ESQUEMA PRO FOOTER FICAR NO FINAL DA TELA */
    display: flex;
    align-items: center;
    flex-direction: column;
}
header, section, footer{
    width: 100%;
    display: flex;
    justify-content: center;
}
.header, .section, .footer{
    width: 100%;
    max-width: var(--body-max-w);
    padding-left: var(--body-lat-m);
    padding-right: var(--body-lat-m);
    display: flex;
    position: relative;
}
.multi-pages{
    width: 100%;
}
label{
    user-select: none;
    display: inline flow-root;
}
/* ================== ATRIBUTOS ================== */
.flex{
    display: flex;
}
.flex-c{
    flex-direction: column;
    align-items: auto;
    justify-content: center;
}
.none{
    display: none;
}
/* TEXT TRANSFORM */
.caps{
    text-transform: uppercase;
}
.italic{
    font-style: italic;
}
.li{
    display: list-item;
    list-style-position: inside;
}
/* IMG PAD */
.imgpad-l{
    padding-left: var(--spc-1);
}
.imgpad-r{
    padding-right: var(--spc-1);
}
/* SPACES */
.space-1{
    height: var(--spc-1);
    width: 100%;
}
.space-2{
    height: var(--spc-2);
    width: 100%;
}
.space-3{
    height: var(--spc-3);
    width: 100%;
}
.space-4{
    height: var(--spc-4);
    width: 100%;
}
.space-5{
    height: var(--spc-5);
    width: 100%;
}
.space-6{
    height: var(--spc-6);
    width: 100%;
}
/* BACKGOUND */
.bgc-0{
    background-color: var(--cor-0);
    z-index: 0;
}
.bgc-1{
    background-color: var(--cor-1);
    z-index: 0;
}
.bgc-2{
    background-color: var(--cor-2);
    position: relative;
    z-index: 0;
}
.bgc-2::after{
    content: "";
    position: absolute;
    background-color: #00000055;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: -1;
}
.bgc-3{
    background-color: var(--cor-3);
    z-index: 0;
}
.bgc-13{
    background-color: var(--cor-13);
    z-index: 0;
}
/* BOX TEXTO */
.box-0{
    background-color: var(--cor-0);
    line-height: 1.5;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 var(--border-2);
}
.box-1{
    background-color: var(--cor-1);
    line-height: 1.5;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 var(--border-2);    
}
.box-2{
    background-color: var(--cor-2);
    line-height: 1.5;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 var(--border-2);    
}
.box-3{
    background-color: var(--cor-3);
    line-height: 1.5;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 var(--border-2);
}
.box-13{
    background-color: var(--cor-13);
    line-height: 1.5;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 var(--border-2);
}
/* FONT WEIGHT */
.fw-r{
    font-weight: 400;
}
.fw-b{
    font-weight: 1000;
}
/* CORES FONTES */
.fc-0{
    color: var(--cor-0);
}
.fc-1{
    color: var(--cor-1);
}
.fc-2{
    color: var(--cor-2);
}
.fc-3{
    color: var(--cor-3);
}
.fc-13{
    color: var(--cor-13);
}
/* TAMANHO FONTE */
.fs-1{
    font-size: var(--txt-1);
}
.fs-2{
    font-size: var(--txt-2);
}
.fs-3{
    font-size: var(--txt-3);
}
.fs-4{
    font-size: var(--txt-4);
}
.fs-5{
    font-size: var(--txt-5);
}
/* FONTES */
.ff-1{
    font-family: "Roboto Condensed", sans-serif;
}
.caps.ff-1{
    letter-spacing: 1px;
}
.ff-2{
    font-family: "Sanchez", serif;
    letter-spacing: 1px;
}
.caps.ff-2{
    letter-spacing: 4px;
}
/* ================== HEADER ================== */
header{
    position: fixed;
    z-index: 2 !important;
    box-shadow: 0 0 0 var(--border-1) inset #2c2c2c08;
}
.header{
    height: var(--header-h);
    align-items: center;
    justify-content: space-between;
}
.false-header{
    height: var(--header-h);
}
.logo{ 
    height: 90%;
    padding: var(--border-2)
}
.logo img{
    height: 100%;
}
.links-pg{
    display: flex;
    gap: var(--spc-5);
    transition: var(--transition) ease-in-out;
}
.links-pg label span{
    font-family: "Roboto Condensed", sans-serif;
    font-size: var(--txt-3);
    font-weight: bolder;
}
.links-pg label{
    position: relative;
}
.links-pg label::after{
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: var(--border-2);
    background-color: var(--cor-13);
    transition: var(--transition) ease-in-out;
}
.links-pg label:has(input:checked)::after {
    width: 100%;
}
.links-pg label:has(input:checked) span{
    color: var(--cor-13);
}
/* ================== PAGE-1 ================== */
section{
    min-height: calc((100vh - var(--header-h)) + var(--spc-5));
    padding-top: var(--spc-4);
    padding-bottom: var(--spc-4);
}
.img-container, .txt-container{
    display: flex;
    justify-content: center;
    flex-direction: column;
}
.section:has(.tit-container){
    flex-wrap: wrap;
}
.tit-container{
    width: 100%;
    height: min-content;
}
.section img{
    width: 100%;
}
.sect-1{
    background-image: url(https://raw.githubusercontent.com/Lyzaran/juventudedemocraticajales/main/img/is2jales-up2k.webp);
    background-repeat: no-repeat;
    background-position: 50% 80%;
    background-size: cover;
}
.sect-1 > .img-bg::after{
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(0deg,rgba(146, 60, 2, 0.1) 0%, rgba(146, 60, 2, 0.25) 45%, rgba(68, 51, 19, 0.4) 100%);
}
.sect-4 .img-container img{
    aspect-ratio: 8/9;
    object-position: 50% 100%;
}
.sect-5 .img-container img{
    aspect-ratio: 8/9;
    object-position: 50% 0%;
}
.sect-7 .img-container img{
    aspect-ratio: 3/4;
    object-position: 60% 50%;
}
.sect-8 .img-container img{
    aspect-ratio: 8/9;
    object-position: 50% 40%;
}
.sect-10 .img-container img{
    aspect-ratio: 8/9;
}
.sect-11 .img-container img{
    aspect-ratio: 8/9;
    object-position: 50% 50%;
}
.sect-13 .img-container img{
    aspect-ratio: 4/5;
    object-position: 50% 40%;
}
.sect-14 .img-container img{
    aspect-ratio: 4/5;
}
.sect-16 .img-container img{
    aspect-ratio: 1/1;
}
.sect-17 .img-container img{
    aspect-ratio: 8/9;
}
.sect-19 .img-container img{
    aspect-ratio: 8/9;
}
.sect-20 .img-container img{
    aspect-ratio: 8/9;
}
.sect-24 .img-container{
    width: 10%;
}
/* PAGE 2 */
.card-container{
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spc-3);
    height: min-content;
}
.card{
    display: flex;
    flex-direction: column;
}
.card-img{
    position: relative;
    aspect-ratio: 2/1;
}
.card-img img{
    width: 100%;
    height: 100%;
    aspect-ratio: 2/1;
}
.card:nth-child(1) .card-img img{
    transform: scale(0.9);
}
.card:nth-child(3) .card-img img{
    transform: scale(0.8);
}
.card-img::after{
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    right: 0;
    background-color: var(--cor-1);
    z-index: -1;
}
.card-txt{
    background-color: var(--cor-13);
    padding: var(--spc-5);
    height: calc(var(--spc-1) * 1.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spc-5);
}
.card-txt p:first-child{
    width: 100%;
}
.sect-22 .img-container img{
    aspect-ratio: 4/5;
}
/* PAGE 3 */
 section.sect-25{
    min-height: calc((100vh - var(--header-h)));
}
